# PostgreSQL connection string
DATABASE_URL=postgresql://room_booker:room_booker@localhost:5432/room_booker

# Set to true when PostgreSQL provider requires TLS (e.g. AWS RDS, Supabase)
DATABASE_SSL=false

# HMAC secret for opaque session tokens (minimum 32 characters)
SESSION_SECRET=local-development-session-secret-change-before-production-32-chars

# Session lifetime in days (from 1 through 30)
SESSION_TTL_DAYS=7

# Canonical application URL used for same-origin verification in production
APP_URL=http://localhost:3000

# Office schedule configuration
OFFICE_TIME_ZONE=Europe/Kyiv
OFFICE_OPEN_HOUR=9
OFFICE_CLOSE_HOUR=19

# Email confirmation requirement for newly registered accounts in development
EMAIL_CONFIRMATION_REQUIRED=true

# Notification lead time in minutes before a booking ends (from 1 through 60)
NOTIFY_BEFORE_MINUTES=10
